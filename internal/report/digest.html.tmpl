{{- /*
  The digest follows the report's rules: light-only, every colour inline,
  every coloured element on an explicit background. It is parsed into a
  clone of the report template, so "chip", pal and T are the report's own.
*/ -}}
{{- define "dhost" -}}
{{- /* one host row: glyph, name, what */ -}}
{{- $p := pal .St}}
<tr class="hc-row" style="background:{{T.Surface}}">
<td class="hc-ink" style="padding:6px 10px;font-size:12px;color:{{T.Ink}};background:{{T.Surface}};vertical-align:top;width:40%;word-break:break-word;border-bottom:1px solid {{T.Rule}}"><span style="color:{{$p.Dot}};font-weight:700">&#9679;</span>&nbsp;{{.Host}}</td>
<td class="hc-ink" style="padding:6px 10px;font-size:12px;color:{{T.Ink}};background:{{T.Surface}};vertical-align:top;word-break:break-word;border-bottom:1px solid {{T.Rule}}">{{.What}}
{{- range .Lines}}<br><span class="hc-muted" style="color:{{T.Muted}};font-size:11px">{{.}}</span>{{end -}}
</td></tr>
{{- end -}}
{{- define "dhead" -}}
<div class="hc-ink" style="font-size:13px;font-weight:700;color:{{T.Ink}};margin:20px 0 8px;background:{{T.Surface}}">{{.}}</div>
{{- end -}}
{{- define "digest" -}}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="color-scheme" content="only light">
<meta name="supported-color-schemes" content="only light">
<title>Hub digest — {{.Collector}}</title>
<style>
  :root { color-scheme: only light; supported-color-schemes: only light; }
  html, body { background: #ffffff !important; }
  .hc-page { background: #f7f7f5 !important; }
  .hc-card, .hc-row { background: #ffffff !important; }
  .hc-row td { background: #ffffff !important; }
  .hc-band { background: #f7f7f5 !important; }
  .hc-ink { color: #1a1a19 !important; }
  .hc-muted { color: #6b6a66 !important; }
</style>
</head>
<body class="hc-page" style="margin:0;padding:0;background:{{T.Surface2}};font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif">
<div class="hc-card" style="max-width:860px;margin:0 auto;background:{{T.Surface}};border:1px solid {{T.Rule}}">

<div class="hc-band" style="padding:18px 22px;border-bottom:1px solid {{T.Rule}};background:{{T.Surface2}}">
<table role="presentation" style="width:100%;border-collapse:collapse"><tr>
<td style="background:{{T.Surface2}}">
<div class="hc-ink" style="font-size:19px;font-weight:700;color:{{T.Ink}};background:{{T.Surface2}}">Hub digest</div>
<div class="hc-ink" style="font-size:12px;color:{{T.Ink}};margin-top:6px;background:{{T.Surface2}}">{{.Tally}}</div>
<div class="hc-muted" style="font-size:11px;color:{{T.Muted}};margin-top:3px;background:{{T.Surface2}}">via {{.Collector}} · lhc {{.VersionLabel}} · {{.Stamp}}</div>
</td>
<td style="text-align:right;white-space:nowrap;background:{{T.Surface2}}">{{template "chip" .Overall}}</td>
</tr></table>
</div>

<div style="padding:4px 22px 20px;background:{{T.Surface}}">
{{- $d := .}}

{{template "dhead" "Collectors"}}
<table role="presentation" style="width:100%;border-collapse:collapse">
{{- range .Collectors}}
{{- if .Silent}}{{template "dhost" (row .Host .Status ($d.PeerText .) "this may be the only digest today")}}
{{- else}}{{template "dhost" (row .Host .Status ($d.PeerText .))}}{{end}}
{{- end}}
</table>

{{- with .Silent}}
{{template "dhead" (print "Silent — no report for over " (hours $d.SilentAfter))}}
<table role="presentation" style="width:100%;border-collapse:collapse">
{{- range .}}{{template "dhost" (row .Host 3 (print "last report " ($d.Since .Last)))}}{{end}}
</table>
{{- end}}

{{- with .NotOK}}
{{template "dhead" "Not OK"}}
<table role="presentation" style="width:100%;border-collapse:collapse">
{{- range .}}{{template "dhost" (notok .)}}{{end}}
</table>
{{- end}}

{{- with .NewHosts}}
{{template "dhead" "New hosts since the last digest"}}
<div class="hc-ink" style="font-size:12px;color:{{T.Ink}};background:{{T.Surface}}">{{join . ", "}}</div>
{{- end}}

{{template "dhead" "Everyone else"}}
<div class="hc-ink" style="font-size:12px;color:{{T.Ink}};background:{{T.Surface}}">{{plural .OK "host"}} OK</div>
{{- with .Totals}}
<div class="hc-muted" style="font-size:12px;color:{{T.Muted}};margin-top:3px;background:{{T.Surface}}">{{.}}</div>
{{- end}}
</div>

<div class="hc-band hc-muted" style="padding:10px 22px;font-size:10px;color:{{T.Muted}};background:{{T.Surface2}};border-top:1px solid {{T.Rule}};text-align:center">
A host that was shut down for good stays SILENT here until you run <code>lhc hub forget HOST</code> on each collector.
</div>

</div>
</body>
</html>
{{- end -}}
